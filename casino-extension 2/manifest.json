{
  "manifest_version": 3,
  "name": "Player Collector",
  "version": "1.1",
  "description": "Collects player data from admin panel",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "offscreen"],
  "host_permissions": [
    "https://lixog.com/*",
    "https://tonapi.io/*",
    "https://sb2admin-altenar2.biahosted.com/*",
    "https://rpc.ankr.com/*",
    "https://ethereum-rpc.publicnode.com/*",
    "https://mainnet.base.org/*",
    "https://arb1.arbitrum.io/*",
    "https://mainnet.optimism.io/*",
    "https://api.avax.network/*",
    "https://bsc-dataseed.binance.org/*",
    "https://bsc-rpc.publicnode.com/*",
    "https://polygon-rpc.com/*",
    "https://polygon-bor-rpc.publicnode.com/*",
    "https://apilist.tronscanapi.com/*",
    "https://blockstream.info/*",
    "https://litecoinspace.org/*",
    "https://api.blockchair.com/*",
    "https://api.blockcypher.com/*"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Player Collector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://lixog.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
